# NEEV Environment Configuration (Template)
# Copy to .env for local development

# Security
SECRET_KEY=neev-phase1-super-secret-key-change-in-production-2026-secure-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_GRACE_PERIOD_SECONDS=15
PASSWORD_RESET_EXPIRE_MINUTES=15

# Keyed HMAC Salt for APAAR Fingerprint Exact-Matching (Must be distinct from SECRET_KEY)
APAAR_FINGERPRINT_KEY=neev-apaar-hmac-fingerprint-salt-key-2026

# Database: PostgreSQL ONLY (SQLite is strictly disallowed in NEEV)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neev_dev
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neev_dev

# Dedicated Test Database (Used automatically during pytest execution)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neev_test

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
